{
  "name": "@can/dsh-jlink",
  "version": "0.1.0",
  "description": "Native DeepSeek Harness plugin for J-Link debugging: manager + tools + device patches + visualization. 原生 J-Link 调试插件（管理器+工具+补丁注册+可视化）。",
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./types": {
      "types": "./lib/types.d.mts",
      "default": "./lib/types.mjs"
    },
    "./client": {
      "types": "./lib/client.d.cts",
      "default": "./lib/client.js"
    },
    "./remote": {
      "types": "./lib/remote.d.mts",
      "default": "./lib/remote.mjs"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "resources",
    "python",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown && tsdown --config tsdown.client.config.ts && node scripts/wrap-client.mjs",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
